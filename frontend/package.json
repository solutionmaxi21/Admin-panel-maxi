{
  "name": "algerian-hardware-e-commerce",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "next build",
    "dev": "next dev",
    "lint": "eslint .",
    "start": "node scripts/start-standalone.mjs",
    "typecheck": "tsc --noEmit",
    "security:audit": "npm audit && cd backend && npm audit && cd ../admin && npm audit && cd ..",
    "security:audit:fix": "npm audit fix && cd backend && npm audit fix && cd ../admin && npm audit fix && cd ..",
    "security:audit:report": "npm audit --json > audit-report.json && cd backend && npm audit --json > ../audit-backend.json && cd ../admin && npm audit --json > ../audit-admin.json && cd ..",
    "security:snyk": "snyk test || echo 'Install Snyk: npm install -g snyk && snyk auth'",
    "security:snyk:all": "snyk test && cd backend && snyk test && cd ../admin && snyk test && cd ..",
    "security:snyk:report": "snyk test --json > snyk-report.json && cd backend && snyk test --json > ../snyk-backend.json && cd ../admin && snyk test --json > ../snyk-admin.json && cd ..",
    "security:test": "bash security-test.sh",
    "security:zap:baseline": "docker run -t owasp/zap2docker-stable zap-baseline.py -t http://localhost:3000 -r baseline-report.html",
    "security:zap:full": "docker run -t owasp/zap2docker-stable zap-full-scan.py -t http://localhost:3000 -r full-report.html",
    "security:zap:api": "docker run -t owasp/zap2docker-stable zap-api-scan.py -t http://localhost:8000 -r api-report.html",
    "security:all": "npm run security:audit && npm run security:audit:report",
    "security:quick": "npm run security:audit"
  },
  "dependencies": {
    "@ducanh2912/next-pwa": "^10.2.9",
    "@hookform/resolvers": "^3.10.0",
    "@radix-ui/react-accordion": "1.2.2",
    "@radix-ui/react-alert-dialog": "1.1.4",
    "@radix-ui/react-aspect-ratio": "1.1.1",
    "@radix-ui/react-avatar": "1.1.2",
    "@radix-ui/react-checkbox": "1.1.3",
    "@radix-ui/react-collapsible": "1.1.2",
    "@radix-ui/react-context-menu": "2.2.4",
    "@radix-ui/react-dialog": "1.1.4",
    "@radix-ui/react-dropdown-menu": "2.1.4",
    "@radix-ui/react-hover-card": "1.1.4",
    "@radix-ui/react-label": "2.1.1",
    "@radix-ui/react-menubar": "1.1.4",
    "@radix-ui/react-navigation-menu": "1.2.3",
    "@radix-ui/react-popover": "1.1.4",
    "@radix-ui/react-progress": "1.1.1",
    "@radix-ui/react-radio-group": "1.2.2",
    "@radix-ui/react-scroll-area": "1.2.2",
    "@radix-ui/react-select": "2.1.4",
    "@radix-ui/react-separator": "1.1.1",
    "@radix-ui/react-slider": "1.2.2",
    "@radix-ui/react-slot": "1.1.1",
    "@radix-ui/react-switch": "1.1.2",
    "@radix-ui/react-tabs": "1.1.2",
    "@radix-ui/react-toast": "1.2.4",
    "@radix-ui/react-toggle": "1.1.1",
    "@radix-ui/react-toggle-group": "1.1.1",
    "@radix-ui/react-tooltip": "1.1.6",
    "@react-oauth/google": "^0.12.2",
    "@tailwindcss/typography": "^0.5.19",
    "autoprefixer": "^10.4.20",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "1.0.4",
    "date-fns": "4.1.0",
    "dexie": "^4.2.1",
    "embla-carousel-react": "8.5.1",
    "expo-dev-client": "^6.0.20",
    "input-otp": "1.4.1",
    "lucide-react": "^0.561.0",
    "next": "^16.1.5",
    "next-themes": "^0.4.6",
    "quill": "^2.0.3",
    "react": "^19.2.4",
    "react-day-picker": "9.8.0",
    "react-dom": "^19.2.4",
    "react-hook-form": "^7.60.0",
    "react-resizable-panels": "^2.1.7",
    "recharts": "2.15.4",
    "sonner": "^1.7.4",
    "tailwind-merge": "^2.5.5",
    "tailwindcss-animate": "^1.0.7",
    "vaul": "^1.1.2",
    "workbox-webpack-plugin": "^7.4.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.9",
    "@types/eslint": "^9.6.1",
    "@types/node": "^22.19.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@typescript-eslint/eslint-plugin": "^8.56.0",
    "@typescript-eslint/parser": "^8.56.0",
    "baseline-browser-mapping": "^2.9.11",
    "eslint": "^9.39.2",
    "eslint-config-next": "^16.1.1",
    "postcss": "^8.5",
    "tailwindcss": "^4.1.9",
    "tw-animate-css": "1.3.3",
    "typescript": "^5"
  }
}

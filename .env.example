# ===============================================
# MaxiStore — variables du monorepo
# ===============================================
# Copier ce fichier en `.env` a la racine, puis :
#   docker compose up -d --build
#
# Pour un lancement SANS Docker, ces variables ne sont pas lues :
# `npm run env:init` genere backend/.env et frontend/.env.local a la place.

# ===============================================
# BASE DE DONNEES
# ===============================================
POSTGRES_USER=maxistore
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=maxistore
# Port publie sur l'hote (5432 est souvent deja pris par un PostgreSQL local)
POSTGRES_PORT=5432

# ===============================================
# PORTS PUBLIES
# ===============================================
# Port unique d'acces a l'application (storefront + API + uploads).
# Le backend n'est PAS expose : il n'est joignable que par le reseau Docker.
WEB_PORT=3000

# ===============================================
# SECRETS — A REGENERER EN PRODUCTION
# ===============================================
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=GENERATE_YOUR_OWN_SECRET_HERE_64_CHARS_MINIMUM
JWT_REFRESH_SECRET=GENERATE_YOUR_OWN_SECRET_HERE_64_CHARS_MINIMUM
HMAC_SECRET=GENERATE_YOUR_OWN_HMAC_SECRET_HERE
REVALIDATION_SECRET=GENERATE_YOUR_OWN_REVALIDATION_SECRET
GUEPEX_WEBHOOK_SECRET=GENERATE_YOUR_OWN_WEBHOOK_SECRET

# ===============================================
# DOMAINE PUBLIC
# ===============================================
# URL par laquelle les utilisateurs accedent au site (sans slash final).
PUBLIC_URL=http://localhost:3000
# Origines autorisees par le CORS du backend (separees par des virgules).
ALLOWED_ORIGINS=http://localhost:3000
# Cookies transmis uniquement en HTTPS — passer a true derriere un domaine TLS.
COOKIE_SECURE=false
NODE_ENV=production

# ===============================================
# SERVICES EXTERNES (optionnels)
# ===============================================
# Google OAuth
GOOGLE_CLIENT_ID=
# Email transactionnel
EMAIL_SERVICE=gmail
EMAIL_USER=
EMAIL_PASS=
# Livraison Guepex — laisser vide pour desactiver l'integration
GUEPEX_API_ID=
GUEPEX_API_TOKEN=
GUEPEX_BASE_URL=https://api.guepex.app/v1
GUEPEX_POLL_INTERVAL_MINUTES=15

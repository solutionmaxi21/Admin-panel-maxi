                  "    pm.test('Has tracking history', () => {",
                  "        pm.expect(jsonData.tracking_number).to.exist;",
                  "        pm.expect(jsonData.history).to.be.an('array');",
                  "    });",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/orders/{{testOrderId}}/tracking-history",
              "host": ["{{baseUrl}}"],
              "path": ["api", "orders", "{{testOrderId}}", "tracking-history"]
            }
          }
        },
        {
          "name": "Public Order Tracking",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const jsonData = pm.response.json();",
                  "    console.log('Order:', jsonData.order_number);",
                  "    console.log('Status:', jsonData.current_status);",
                  "    pm.test('Order tracking works', () => {",
                  "        pm.expect(jsonData.order_number).to.exist;",
                  "        pm.expect(jsonData.current_status).to.exist;",
                  "    });",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/orders/tracking/ORD-000014",
              "host": ["{{baseUrl}}"],
              "path": ["api", "orders", "tracking", "ORD-000014"]
            }
          }
        }
      ]
    },
    {
      "name": "4. Webhooks",
      "item": [
        {
          "name": "Webhook - Status Update (En transit)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const tracking = pm.collectionVariables.get('testTrackingNumber');",
                  "if (!tracking) {",
                  "    console.log('❌ ERROR: testTrackingNumber is empty!');",
                  "    console.log('💡 Run \"Create Single Shipment\" first to get tracking number');",
                  "} else {",
                  "    console.log('✅ Using tracking number:', tracking);",
                  "}"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Webhook accepted', () => {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 204]);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {"key": "Content-Type", "value": "application/json"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tracking\": \"{{testTrackingNumber}}\",\n  \"last_status\": \"En transit\",\n  \"status_reason\": null,\n  \"occurred_at\": \"2026-01-04T10:00:00Z\"\n}"

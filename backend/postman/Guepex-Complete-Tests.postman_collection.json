            "url": {
              "raw": "{{baseUrl}}/api/orders/{{testOrderId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "orders", "{{testOrderId}}"]
            }
          }
        },
        {
          "name": "Get Tracking History",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const jsonData = pm.response.json();",

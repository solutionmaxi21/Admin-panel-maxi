{
  "info": {
    "_postman_id": "guepex-complete-tests-v3",
    "name": "Guepex API - Complete Integration Tests",
    "description": "Comprehensive test suite for all Guepex API features including shipments, tracking, webhooks, returns, and polling",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3001",
      "type": "string"
    },
    {
      "key": "adminToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "userToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "testOrderId",
      "value": "14",
      "type": "string"
    },
    {
      "key": "testOrderId2",
      "value": "15",
      "type": "string"
    },
    {
      "key": "testTrackingNumber",
      "value": "",
      "type": "string"
    },
    {
      "key": "testReturnId",
      "value": "1",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "0. Test Data Setup",
      "description": "Run these endpoints to prepare orders for testing. Reset Order 14 clears tracking, Confirm Order 15 prepares for batch tests.",
      "item": [
        {
          "name": "Reset Order 14 for Testing",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const jsonData = pm.response.json();",
                  "    console.log('✅ Order 14 reset - ready for new shipment test');",
                  "    console.log('Status:', jsonData.data.current_status);",
                  "    console.log('Tracking:', jsonData.data.tracking_number || 'Cleared');",
                  "    pm.test('Order reset successfully', () => {",
                  "        pm.expect(jsonData.success).to.be.true;",
                  "        pm.expect(jsonData.data.tracking_number).to.be.null;",
                  "    });",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              {"key": "Authorization", "value": "Bearer {{adminToken}}"},
              {"key": "Content-Type", "value": "application/json"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"notes\": \"Reset for testing - cleared tracking number\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/orders/{{testOrderId}}/reset-shipment",
              "host": ["{{baseUrl}}"],
              "path": ["api", "orders", "{{testOrderId}}", "reset-shipment"]
            }
          }
        },
        {
          "name": "Confirm Order 15 for Batch Test",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const jsonData = pm.response.json();",
                  "    console.log('✅ Order 15 confirmed for batch test');",
                  "    console.log('Status:', jsonData.data.current_status);",
                  "    pm.test('Order confirmed', () => {",
                  "        pm.expect(jsonData.success).to.be.true;",
                  "        pm.expect(jsonData.data.current_status).to.eql('processing');",
                  "    });",
                  "} else if (pm.response.code === 404) {",
                  "    console.log('⚠️ Order 15 not found - update testOrderId2 variable');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              {"key": "Authorization", "value": "Bearer {{adminToken}}"},
              {"key": "Content-Type", "value": "application/json"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"confirmed\",\n  \"notes\": \"Confirmed for batch shipment testing\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/orders/{{testOrderId2}}/phone-confirmation",
              "host": ["{{baseUrl}}"],
              "path": ["api", "orders", "{{testOrderId2}}", "phone-confirmation"]
            }
          }
        }
      ]
    },
    {
      "name": "1. Authentication",
      "item": [
        {
          "name": "Admin Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const jsonData = pm.response.json();",
                  "    if (jsonData.accessToken) {",
                  "        pm.collectionVariables.set('adminToken', jsonData.accessToken);",
                  "        console.log('✅ Admin token saved');",
                  "    }",
                  "    pm.test('Admin login successful', () => {",
                  "        pm.expect(jsonData.success).to.be.true;",
                  "        pm.expect(jsonData.user.role).to.eql('admin');",
                  "    });",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@maxistore.com\",\n  \"password\": \"admin123\",\n  \"isAdmin\": true\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            }
          }
        },
        {
          "name": "Customer Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const jsonData = pm.response.json();",
                  "    if (jsonData.accessToken) {",
                  "        pm.collectionVariables.set('userToken', jsonData.accessToken);",
                  "        console.log('✅ Customer token saved');",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"sifoubiad001@gmail.com\",\n  \"password\": \"customer123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            }
          }
        }
      ]
    },
    {
      "name": "2. Shipment Creation",
      "item": [
        {
          "name": "Get Order Before Shipment",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const jsonData = pm.response.json();",
                  "    console.log('Order Status:', jsonData.data.current_status);",
                  "    console.log('Phone Confirmed:', jsonData.data.phone_confirmation_status);",
                  "    console.log('Tracking:', jsonData.data.tracking_number || 'None');",
                  "    ",
                  "    pm.test('Order retrieved', () => pm.expect(jsonData.success).to.be.true);",
                  "    ",
                  "    if (jsonData.data.tracking_number) {",
                  "        console.log('⚠️ Order already has tracking - run \"Reset Order 14\" first');",
                  "    } else if (jsonData.data.phone_confirmation_status !== 'confirmed') {",
                  "        console.log('⚠️ Order needs phone confirmation - run \"Phone Confirm Order\" first');",
                  "    } else {",
                  "        console.log('✅ Order ready for shipment creation');",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {"key": "Authorization", "value": "Bearer {{adminToken}}"}
            ],
            "url": {
              "raw": "{{baseUrl}}/api/orders/{{testOrderId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "orders", "{{testOrderId}}"]
            }
          }
        },
        {
          "name": "Phone Confirm Order",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const jsonData = pm.response.json();",
                  "    pm.test('Order confirmed', () => {",
                  "        pm.expect(jsonData.success).to.be.true;",
                  "        pm.expect(jsonData.data.current_status).to.eql('processing');",
                  "    });",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              {"key": "Authorization", "value": "Bearer {{adminToken}}"},
              {"key": "Content-Type", "value": "application/json"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"confirmed\",\n  \"notes\": \"Customer confirmed order via phone - ready for Guepex shipment\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/orders/{{testOrderId}}/phone-confirmation",
              "host": ["{{baseUrl}}"],
              "path": ["api", "orders", "{{testOrderId}}", "phone-confirmation"]
            }
          }
        },
        {
          "name": "Create Single Shipment",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200 || pm.response.code === 201) {",
                  "    const jsonData = pm.response.json();",
                  "    // Extract tracking from data object",
                  "    const tracking = jsonData.data?.tracking || jsonData.tracking;",
                  "    ",
                  "    if (tracking) {",
                  "        pm.collectionVariables.set('testTrackingNumber', tracking);",
                  "        console.log('✅ Tracking number saved:', tracking);",
                  "    } else {",
                  "        console.log('⚠️ No tracking number in response:', JSON.stringify(jsonData, null, 2));",
                  "    }",
                  "    ",
                  "    pm.test('Shipment created', () => {",
                  "        pm.expect(jsonData.success).to.be.true;",
                  "        pm.expect(jsonData.data).to.exist;",
                  "        pm.expect(jsonData.data.tracking).to.exist;",
                  "        pm.expect(jsonData.data.labelUrl).to.exist;",
                  "    });",
                  "} else if (pm.response.code === 400) {",
                  "    const error = pm.response.json();",
                  "    console.log('❌ Error:', error.error);",
                  "    if (error.error.includes('already has tracking')) {",
                  "        console.log('💡 Solution: Run \"Reset Order 14\" from Test Data Setup folder');",
                  "    } else if (error.error.includes('phone-confirmed')) {",
                  "        console.log('💡 Solution: Run \"Phone Confirm Order\" first');",
                  "    }",
                  "} else {",
                  "    console.log('Error:', pm.response.json());",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {"key": "Authorization", "value": "Bearer {{adminToken}}"},
              {"key": "Content-Type", "value": "application/json"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"prepaidAmount\": 0\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/orders/{{testOrderId}}/create-shipment",
              "host": ["{{baseUrl}}"],
              "path": ["api", "orders", "{{testOrderId}}", "create-shipment"]
            }
          }
        },
        {
          "name": "Create Batch Shipments",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const jsonData = pm.response.json();",
                  "    console.log('✅ Successful:', jsonData.success.length);",
                  "    console.log('❌ Failed:', jsonData.failed.length);",
                  "    ",
                  "    if (jsonData.failed.length > 0) {",
                  "        console.log('Failed orders:', JSON.stringify(jsonData.failed, null, 2));",
                  "    }",
                  "    ",
                  "    pm.test('Batch processed', () => {",
                  "        pm.expect(jsonData.success).to.be.an('array');",
                  "        pm.expect(jsonData.failed).to.be.an('array');",
                  "    });",
                  "} else if (pm.response.code === 400) {",
                  "    const error = pm.response.json();",
                  "    console.log('❌ Error:', error.error);",
                  "    if (error.error.includes('No valid orders')) {",
                  "        console.log('💡 Solution: Run \"Confirm Order 15\" from Test Data Setup');",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {"key": "Authorization", "value": "Bearer {{adminToken}}"},
              {"key": "Content-Type", "value": "application/json"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"orderIds\": [{{testOrderId}}, {{testOrderId2}}]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/orders/batch-create-shipments",
              "host": ["{{baseUrl}}"],
              "path": ["api", "orders", "batch-create-shipments"]
            }
          }
        }
      ]
    },
    {

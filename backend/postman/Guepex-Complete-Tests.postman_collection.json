                  "    console.log('Carrier:', jsonData.data.carrier);",
                  "    console.log('Shipment Status:', jsonData.data.shipment_status);",
                  "    pm.test('Has tracking number', () => {",
                  "        pm.expect(jsonData.data.tracking_number).to.exist;",
                  "        pm.expect(jsonData.data.carrier).to.eql('Guepex');",
                  "    });",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {"key": "Authorization", "value": "Bearer {{adminToken}}"}

{
  "name": "store-backend",
  "version": "1.0.0",
  "description": "Backend API for MaxiStore Admin Panel",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "start:prod": "pm2 start ecosystem.config.cjs --env production",
    "start:staging": "pm2 start ecosystem.config.cjs --env staging",
    "dev": "nodemon server.js",
    "stop": "pm2 stop maxistore-backend",
    "restart": "pm2 restart maxistore-backend",
    "logs": "pm2 logs maxistore-backend",
    "monit": "pm2 monit",
    "migrate": "npx prisma migrate deploy",
    "migrate:dev": "npx prisma migrate dev",
    "migrate:passwords": "node src/scripts/migrate-passwords.js",
    "db:seed": "node prisma/seed.js",
    "db:bootstrap": "node scripts/apply-schema.mjs",
    "db:check": "node scripts/apply-schema.mjs --check",
    "db:studio": "npx prisma studio",
    "test:smoke": "k6 run k6/smoke-test.js",
    "test:api": "k6 run k6/api-test.js",
    "test:load": "k6 run k6/load-test.js",
    "test:load:hard": "k6 run k6/load-test.js",
    "test:stress": "k6 run k6/stress-test.js",
    "test:soak": "k6 run k6/soak-test.js",
    "test:spike": "k6 run k6/spike-test.js",
    "test:complex": "k6 run k6/complex-queries-test.js",
    "test:debug": "k6 run k6/debug-test.js",
    "test:breakpoint": "k6 run k6/breakpoint-test.js",
    "test:all": "npm run test:smoke && npm run test:api && npm run test:load",
    "test:full": "npm run test:all && npm run test:stress",
    "test:with-report": "k6 run --out json=k6/results/results.json k6/load-test.js && node k6/utils/generate-report.cjs && start k6/results/report.html"
  },
  "keywords": [
    "api",
    "express",
    "store"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@prisma/adapter-pg": "^7.1.0",
    "@prisma/client": "^7.1.0",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^8.2.1",
    "google-auth-library": "^10.5.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2",
    "node-cache": "^5.1.2",
    "node-fetch": "^3.3.2",
    "nodemailer": "^7.0.11",
    "pg": "^8.16.3",
    "pino": "^10.1.0",
    "pino-http": "^11.0.0",
    "prisma": "^6.12.0",
    "sharp": "^0.33.5",
    "uuid": "^13.0.0",
    "zod": "^4.1.13",
    "zxcvbn": "^4.4.2"
  },
  "devDependencies": {
    "nodemon": "^3.0.1",
    "pino-pretty": "^13.1.3",
    "pm2": "^5.3.0"
  }
}

# ===============================================
# MaxiStore Backend - Environment Configuration
# ===============================================
# IMPORTANT: Copy this file to .env and fill in your actual values
# NEVER commit .env file to version control!

# ===============================================
# SERVER CONFIGURATION
# ===============================================
PORT=3001
NODE_ENV=production

# ===============================================
# DATABASE CONFIGURATION
# ===============================================
# Format: postgresql://username:password@host:port/database
# Example: postgresql://myuser:mypassword@localhost:5432/maxistore
DATABASE_URL=postgresql://username:password@localhost:5432/maxistore

# ===============================================
# JWT SECRETS - CRITICAL: GENERATE STRONG SECRETS!
# ===============================================
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# DO NOT use the example values below - generate your own!
JWT_ACCESS_SECRET=GENERATE_YOUR_OWN_SECRET_HERE_64_CHARS_MINIMUM
JWT_REFRESH_SECRET=GENERATE_YOUR_OWN_SECRET_HERE_64_CHARS_MINIMUM

# ===============================================
# SECURITY CONFIGURATION
# ===============================================
# Comma-separated list of allowed origins (no trailing slashes)
ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# Bcrypt salt rounds (10-12 recommended, higher = more secure but slower)
BCRYPT_SALT_ROUNDS=12

# HMAC secret for offline sync (generate strong random string)
HMAC_SECRET=GENERATE_YOUR_OWN_HMAC_SECRET_HERE

# Cookie secure flag (set to 'false' for HTTP-only deployments like Electron local)
# Default: true in production, false in development
COOKIE_SECURE=true

# ===============================================
# TOKEN EXPIRATION CONFIGURATION
# ===============================================
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d
REFRESH_TOKEN_COOKIE_DAYS=7
PASSWORD_RESET_EXPIRY_MINUTES=30
EMAIL_VERIFICATION_EXPIRY_HOURS=24

# ===============================================
# CLIENT CONFIGURATION
# ===============================================
CLIENT_URL=https://yourdomain.com
FRONTEND_URL=https://yourdomain.com

# Google OAuth Client ID (get from Google Cloud Console)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# ===============================================
# RATE LIMITING
# ===============================================
# Window in milliseconds (900000 = 15 minutes)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=5

# ===============================================
# CACHE CONFIGURATION
# ===============================================
CACHE_ENABLED=true
REVALIDATION_SECRET=GENERATE_YOUR_OWN_REVALIDATION_SECRET
STORE_URL=https://yourdomain.com

# ===============================================
# TEST ADMIN ACCOUNT (Remove in production!)
# ===============================================
TEST_ADMIN_EMAIL=admin@maxistore.com
TEST_ADMIN_PASSWORD=ChangeThisPassword123!

# ===============================================
# EMAIL CONFIGURATION
# ===============================================
# Email service provider (gmail, sendgrid, mailgun, etc.)
EMAIL_SERVICE=gmail

# For Gmail: Use App Password (not your regular password)
# Enable 2FA and generate app password at: https://myaccount.google.com/apppasswords
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-gmail-app-password

# ===============================================
# GUEPEX SHIPPING API CONFIGURATION
# ===============================================
# Get credentials from: https://guepex.app/app/dev/index.php
# IMPORTANT: Keep these credentials secure!
GUEPEX_API_ID=your-guepex-api-id
GUEPEX_API_TOKEN=your-guepex-api-token
GUEPEX_BASE_URL=https://api.guepex.app/v1

# Webhook secret for verifying Guepex callbacks
GUEPEX_WEBHOOK_SECRET=GENERATE_YOUR_OWN_WEBHOOK_SECRET

# Polling interval in minutes (how often to check order status)
GUEPEX_POLL_INTERVAL_MINUTES=15

# ===============================================
# LOGGING CONFIGURATION (Optional)
# ===============================================
# Log level: fatal, error, warn, info, debug, trace
LOG_LEVEL=info

# Pretty logging (set to true for development, false for production)
LOG_PRETTY=false

# ===============================================
# DEPLOYMENT NOTES
# ===============================================
# 1. Generate all secrets using strong random values
# 2. Update ALLOWED_ORIGINS with your actual domain(s)
# 3. Configure your database connection string
# 4. Set up email provider credentials
# 5. Configure Guepex API credentials if using shipping
# 6. Remove or secure TEST_ADMIN credentials
# 7. Set NODE_ENV=production
# 8. Ensure PostgreSQL is running and accessible
# 9. Run: npm install --production
# 10. Run migrations: npx prisma migrate deploy
# 11. Start with PM2: pm2 start ecosystem.config.cjs
